#!/usr/bin/env bash
# PhpStorm-style scratch files for Zed. Scratches live in one shared folder in Zed's user data folder. Every project
# gets a link to it at .zed/scratches, so the same files show in each project's file tree. (Adding the folder as an
# extra project root doesn't work across windows: Zed sends it to whichever window already has it.) .zed is never
# deployed by iRemote, and .zed/scratches is in the global gitignore.
#
#   scratch new <ext>   link the project, create scratch_N.<ext>, open it   (tasks "scratch: PHP", … — ⇧⌘N)
#   scratch show        link the project only                                 (task "scratch: show files")
set -euo pipefail

if [[ "$(uname)" == Darwin ]]; then
  dir="$HOME/Library/Application Support/Zed/scratches"
else
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/zed/scratches"
fi
mkdir -p "$dir"

# Link .zed/scratches in the project the task runs in (Zed sets ZED_WORKTREE_ROOT).
link_project() {
  local root="${ZED_WORKTREE_ROOT:-}" link
  [[ -n "$root" && -d "$root" ]] || return 0
  link="$root/.zed/scratches"
  [[ -e "$link" || -L "$link" ]] && return 0
  mkdir -p "$root/.zed"
  ln -s "$dir" "$link"
}

zed_cli() {
  if command -v zed >/dev/null; then zed "$@"
  elif [[ -x /Applications/Zed.app/Contents/MacOS/cli ]]; then /Applications/Zed.app/Contents/MacOS/cli "$@"
  else echo "zed CLI not found (run 'zed: install cli' in Zed)" >&2; exit 1
  fi
}

next_name() {
  # scratch, scratch_1, scratch_2, ... numbered across all types, like PhpStorm.
  local max=-1 f base n
  shopt -s nullglob
  for f in "$dir"/scratch.* "$dir"/scratch_*.*; do
    base=$(basename "$f"); base=${base%%.*}
    if [[ "$base" == scratch ]]; then n=0; else n=${base#scratch_}; fi
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > max )) && max=$n
  done
  if (( max < 0 )); then echo scratch; else echo "scratch_$((max + 1))"; fi
}

case "${1:-new}" in
  new)
    ext=${2:-txt}
    [[ "$ext" =~ ^[A-Za-z0-9]+$ ]] || { echo "bad extension: $ext" >&2; exit 2; }
    file="$dir/$(next_name).$ext"
    case "$ext" in
      php) printf '<?php\n\n' >"$file" ;;
      sh) printf '#!/usr/bin/env bash\n\n' >"$file" ;;
      *) : >"$file" ;;
    esac
    link_project
    zed_cli --existing "$file"
    ;;
  show)
    link_project
    ;;
  *)
    echo "usage: scratch new <ext> | scratch show" >&2; exit 2
    ;;
esac
