// Zed key bindings. See https://zed.dev/docs/key-bindings
[
  {
    // ⇧⌘N: new scratch file, as in PhpStorm (replaces the JetBrains keymap's file finder; ⌘P still opens it).
    "context": "Workspace",
    "bindings": {
      "cmd-shift-n": ["task::Spawn", { "task_name": "New scratch file" }]
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-shift-n": ["task::Spawn", { "task_name": "New scratch file" }]
    }
  }
]
