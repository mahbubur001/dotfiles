// Zed key bindings. See https://zed.dev/docs/key-bindings
[
  {
    // ⇧⌘N: task picker, type e.g. "php" for "scratch: PHP" (PhpStorm's new scratch file). Replaces the
    // JetBrains keymap's file finder here; ⌘P still opens it.
    "context": "Workspace",
    "bindings": {
      "cmd-shift-n": "task::Spawn"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-shift-n": "task::Spawn"
    }
  }
]
